    {
      "name": "03 Gemini real - propuesta, guardado explícito y PDF",
      "item": [
        {
          "name": "R01 Propuesta con proveedor real autorizado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Token {{hu028_candidate_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{hu028_api_origin}}/api/curriculum/generated/assistant/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Ana QA. Ingeniera de Software de Universidad QA. Desarrolladora en Equipo QA. Python avanzado. Español nativo.\",\n  \"include_profile\": false,\n  \"consent\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const result = pm.response.json();",
                  "pm.test(\"No se guarda automáticamente\", () => pm.expect(result.saved).to.eql(false));",
                  "pm.test(\"Contrato del borrador\", () => { pm.expect(result.suggestion.data.personal.full_name).to.be.a(\"string\"); for (const k of [\"education\",\"experience\",\"skills\",\"languages\",\"certifications\",\"extra_sections\"]) pm.expect(result.suggestion.data[k]).to.be.an(\"array\"); });",
                  "pm.test(\"Proveedor real identificado\", () => { pm.expect(result.provider).to.eql(\"Gemini\"); pm.expect(result.model).not.to.contain(\"qa-\"); });",
                  "pm.test('Esquema revisable', () => pm.expect(pm.response.json().suggestion.missing_information).to.be.an('array'));",
                  "pm.variables.set('hu028_proposal_json', JSON.stringify(pm.response.json().suggestion.data));"
                ]
              }
            }
          ]
        },
        {
          "name": "R02 Generar no guarda el CV",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
