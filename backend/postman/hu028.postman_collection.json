                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('CV sin guardar después de generar', () => pm.expect(pm.response.json().exists).to.eql(false));"
                ]
              }
            }
          ]
        },
