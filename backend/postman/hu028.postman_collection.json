  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const origin = pm.environment.get('hu028_api_origin');",
          "if (!/^http:\\/\\/127\\.0\\.0\\.1:[0-9]{4,5}$/.test(origin || '') || !/^run-/.test(pm.environment.get('hu028_run_id') || '')) { throw new Error('Solo QA HU028 aislada y nueva'); }"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('QA aislada correcta', () => pm.expect(pm.response.headers.get('X-WorkNet-QA-Run')).to.eql(pm.environment.get('hu028_run_id')));"
        ]
      }
    }
  ]
