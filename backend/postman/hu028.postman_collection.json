          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Guardado 200 o 201', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));",
                  "pm.test('Plantilla clasica', () => pm.expect(pm.response.json().curriculum.template).to.eql('clasica'));"
                ]
              }
            }
          ]
        },
