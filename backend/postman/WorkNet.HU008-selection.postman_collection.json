  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const base=pm.environment.get(\"base_url\") || \"\";",
          "if (!/^http:\\/\\/(127\\.0\\.0\\.1|localhost):\\d+\\/api$/.test(base) || pm.environment.get(\"qa_confirmation\") !== \"SOLO_BASE_AISLADA\" || !/^run-/.test(pm.environment.get(\"qa_run_id\") || \"\")) throw new Error(\"Importa el entorno privado generado por qa.py prepare. Solo base QA local.\");"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "A - HU008 Datos permitidos y lectura",
      "item": [
        {
          "id": "7efd1fe5-d7a6-4b15-b43f-5eb41122fa82",
          "name": "QA01 - Filtrar campos historicos privados",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/company/applications/{{selection_application_id}}/profile/",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{company_token}}"
              }
            ],
            "description": "HU008 #60/#62. Datos aislados; ejecutar solo la carpeta correspondiente al estado preparado por selection_qa.py. Commit 2547c37. No es un endpoint de preparacion de QA."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "const j=pm.response.json();pm.test(\"Respuesta JSON\",()=>pm.expect(j).to.be.an(\"object\"));",
                  "pm.test(\"Solo campos de perfil permitidos\",()=>{pm.expect(Object.keys(j).sort()).to.eql([\"application\",\"candidate\",\"profile\",\"profile_completion\"]);pm.expect(Object.keys(j.candidate).sort()).to.eql([\"full_name\",\"id\"]);pm.expect(j.candidate.id).to.equal(pm.environment.get(\"candidate_id\"));const allowed={education:[\"id\",\"qualification\",\"institution\",\"start_date\",\"end_date\",\"description\"],experience:[\"id\",\"position\",\"company\",\"start_date\",\"end_date\",\"description\"],skills:[\"id\",\"name\",\"level\"],languages:[\"id\",\"name\",\"level\"]};for(const [s,keys] of Object.entries(allowed)){for(const row of j.profile[s]){pm.expect(Object.keys(row).every(k=>keys.includes(k))).to.equal(true);pm.expect(row).not.to.have.property(\"internal_note\");}}});"
                ]
              }
            }
          ]
        },
