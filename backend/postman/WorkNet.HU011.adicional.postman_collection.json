      "name": "A - HU011 Propiedad y politicas PDF",
      "item": [
        {
          "id": "a1018b48-0764-4a7b-b784-c4e221df623a",
          "name": "HU011-QA01 - Contenido del reemplazo persistido",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/curriculum/uploaded/",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Token {{candidate_token}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "const crypto=require(\"crypto-js\");const bytes=Array.from(pm.response.stream);const words=[];bytes.forEach((b,i)=>{words[i>>>2]=(words[i>>>2]||0)|(b<<(24-(i%4)*8));});const hash=crypto.SHA256(crypto.lib.WordArray.create(words,bytes.length)).toString();",
                  "pm.test(\"Contenido PDF exacto y privado\",()=>{pm.expect(hash).to.equal(\"4ece58b1eddc03ac323fc7b4cac05327757c9653f8972c86f11ad3d5835d5399\");pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/pdf\");pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"private\");pm.expect(pm.response.headers.get(\"Vary\")).to.include(\"Authorization\");});"
                ]
              }
            }
          ]
        },
