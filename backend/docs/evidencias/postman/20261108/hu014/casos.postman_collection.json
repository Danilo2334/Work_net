          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"Oferta editada Desktop HU014\", \"description\": \"Descripci\\u00f3n editada QA\", \"requirements\": \"Django y Flutter QA\", \"salary\": \"3200000.50\", \"location\": \"Pasto QA\", \"category\": \"Tecnolog\\u00eda\", \"contract_type\": \"Fijo\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>{pm.response.to.have.status(200);});",
              "pm.test(\"Respuesta JSON\",()=>{pm.expect(pm.response.json()).to.be.an(\"object\");});",
              "pm.test(\"Edici\\u00f3n y propietario conservados\",()=>{const o=pm.response.json().offer;pm.expect(o.title).to.equal(\"Oferta editada Desktop HU014\");pm.expect(o.salary).to.equal(\"3200000.50\");const b=JSON.parse(pm.environment.get(\"offer_initial\"));for(const k of [\"id\",\"company_name\",\"status\",\"published_at\",\"expires_at\"])pm.expect(o[k]).to.deep.equal(b[k]);pm.environment.set(\"offer_edited\",JSON.stringify(o));});"
            ]
          }
        }
      ]
