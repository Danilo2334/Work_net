      "name": "D14-01 Listado propio activo",
      "id": "6b74d59e-51ff-4ede-bb4a-b108cc5ff322",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/company/offers/active/",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Token {{company_token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>{pm.response.to.have.status(200);});",
              "pm.test(\"Respuesta JSON\",()=>{pm.expect(pm.response.json()).to.be.an(\"object\");});",
              "pm.test(\"Solo dos ofertas propias activas\",()=>{const j=pm.response.json();pm.expect(j.count).to.equal(2);pm.expect(j.offers).to.have.length(2);});"
            ]
          }
        }
      ]
    },
