        "url": "{{base_url}}/company/offers/",
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"Oferta ficticia HU013 Desktop\", \"description\": \"Prueba aislada de publicacion\", \"requirements\": \"Django y Flutter\", \"salary\": \"3000000.50\", \"location\": \"Pasto\", \"category\": \"Tecnolog\u00eda\", \"contract_type\": \"Indefinido\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
              "const o=pm.response.json().offer;",
              "pm.test(\"Publicada\",()=>pm.expect(o.status).to.eql(\"published\"));",
              "pm.test(\"Fecha\",()=>pm.expect(o.published_at).to.be.a(\"string\"));",
              "pm.test(\"Datos conservados\",()=>{pm.expect(o.title).to.eql(\"Oferta ficticia HU013 Desktop\");pm.expect(o.salary).to.eql(\"3000000.50\");});",
              "pm.test(\"Identificador\",()=>pm.expect(o.id).to.be.above(0));",
              "pm.test(\"Empresa propietaria y estado publicados\",()=>{const o=pm.response.json().offer;pm.expect(o.company_name).to.equal(\"Empresa aprobada QA\");pm.expect(o.status).to.equal(\"published\");pm.environment.set(\"published_offer_id\",o.id);});"
            ]
          }
        }
      ]
