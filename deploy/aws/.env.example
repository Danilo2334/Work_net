# Copy outside the repository, e.g. /etc/worknet/worknet.env, chmod 600.
# Generated private values must never be copied to Git or Flutter.
WORKNET_DOMAIN=
WORKNET_PUBLIC_ORIGIN=
WORKNET_WEB_ROOT=/opt/worknet/web
WORKNET_ENV_FILE=/etc/worknet/worknet.env
WORKNET_DATABASE_ENV_FILE=/etc/worknet/database.env
DJANGO_SECRET_KEY=
POSTGRES_DB=worknet
POSTGRES_USER=worknet
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://cache:6379/0
GMAIL_USER=
GMAIL_APP_PASSWORD=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CURRICULUM_AI_RATE=5/hour
