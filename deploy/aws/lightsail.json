{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "WorkNet presentation server in us-east-2. Creating this stack consumes AWS credits. No secrets in parameters or UserData.",
  "Parameters": {
    "InstanceName": {"Type": "String", "Default": "worknet-presentacion", "AllowedPattern": "[a-z][a-z0-9-]{2,40}"},
    "AdminCidr": {"Type": "String", "Description": "Operator public IPv4 /32; never 0.0.0.0/0", "AllowedPattern": "([0-9]{1,3}\\.){3}[0-9]{1,3}/32"},
    "KeyPairName": {"Type": "String", "Description": "Existing Lightsail SSH public key in us-east-2"},
    "AvailabilityZone": {"Type": "String", "Default": "us-east-2a", "AllowedPattern": "us-east-2[a-z]"}
  },
  "Resources": {
    "Server": {
      "Type": "AWS::Lightsail::Instance",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "InstanceName": {"Ref": "InstanceName"},
        "AvailabilityZone": {"Ref": "AvailabilityZone"},
        "BlueprintId": "ubuntu_24_04",
        "BundleId": "small_3_0",
        "KeyPairName": {"Ref": "KeyPairName"},
        "Networking": {"Ports": [
          {"FromPort": 22, "ToPort": 22, "Protocol": "tcp", "Cidrs": [{"Ref": "AdminCidr"}]},
          {"FromPort": 80, "ToPort": 80, "Protocol": "tcp", "Cidrs": ["0.0.0.0/0"]},
          {"FromPort": 443, "ToPort": 443, "Protocol": "tcp", "Cidrs": ["0.0.0.0/0"]}
        ]},
        "Tags": [{"Key": "Project", "Value": "WorkNet"}, {"Key": "Purpose", "Value": "presentation"}],
        "UserData": "#!/bin/bash\nset -eu\nexport DEBIAN_FRONTEND=noninteractive\napt-get update\napt-get install -y docker.io docker-compose-v2 ca-certificates\nsystemctl enable --now docker\ninstall -d -m 0755 /opt/worknet/releases /opt/worknet/web\ninstall -d -m 0700 /etc/worknet /var/backups/worknet\n"
      }
    },
    "Address": {
      "Type": "AWS::Lightsail::StaticIp",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "StaticIpName": {"Fn::Sub": "${InstanceName}-ip"},
        "AttachedTo": {"Ref": "Server"}
      }
    }
  },
  "Outputs": {
    "InstanceName": {"Value": {"Ref": "Server"}},
    "PublicIp": {"Value": {"Fn::GetAtt": ["Address", "IpAddress"]}},
    "Region": {"Value": {"Ref": "AWS::Region"}}
  }
}
